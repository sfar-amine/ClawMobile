{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claw-voice-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "VOICE_RELAY", "class_name": "VoiceRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VoiceRelay"] }
  ]
}
