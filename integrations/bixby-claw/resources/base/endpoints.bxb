endpoints {
  action-endpoints {
    action-endpoint (AskClaw) {
      accepted-inputs (request, $vivContext)
      local-endpoint (AskClaw.js)
    }

    action-endpoint (ContinueClaw) {
      accepted-inputs (conversationId, question, answer, $vivContext)
      local-endpoint (ContinueClaw.js)
    }
  }
}
