action (ContinueClaw) {
  description (Continuer une conversation Claw après une question de clarification.)
  type (Search)

  collect {
    input (conversationId) {
      type (ConversationId)
      min (Required)
      max (One)
      plan-behavior (Direct)
    }
    input (question) {
      type (ClarificationQuestion)
      min (Required)
      max (One)
      plan-behavior (Direct)
    }
    input (answer) {
      type (ClarificationAnswer)
      min (Required)
      max (One)
      plan-behavior (Never)
      prompt-behavior (AlwaysElicitation)
    }
  }

  output (Response) {
    throws {
      error (NeedsClarification) {
        property (nextQuestion) {
          type (ClarificationQuestion)
          min (Required)
          max (One)
        }
        on-catch {
          replan {
            intent {
              subplan {
                goal { @prompt-behavior(AlwaysElicitation) ClarificationAnswer }
              }
              goal: Response
              route: ContinueClaw
              value: $expr(conversationId)
              value: $expr(nextQuestion)
            }
          }
        }
      }
    }
  }
}
