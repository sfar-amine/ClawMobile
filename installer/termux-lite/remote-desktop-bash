#!/data/data/com.termux/files/usr/bin/bash
# Managed shell boundary for RDC child commands. Keep this environment minimal
# and secret-free; Desktop Commander's MCP SDK intentionally filters env vars.
export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export TMPDIR="${TMPDIR:-$HOME/.cache/tmp}"
export TMP="${TMP:-$TMPDIR}"
export TEMP="${TEMP:-$TMPDIR}"
mkdir -p "$TMPDIR"
chmod 700 "$TMPDIR" 2>/dev/null || true
exec /data/data/com.termux/files/usr/bin/bash "$@"
