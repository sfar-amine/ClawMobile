# Copy to ~/.openclaw/secrets/incident-email.env and chmod 600. Never commit the real file.
INCIDENT_EMAIL_TO=you@example.com
INCIDENT_EMAIL_FROM=sender@example.com
INCIDENT_EMAIL_SMTP_URL=smtps://smtp.example.com:465
INCIDENT_EMAIL_USER=sender@example.com
INCIDENT_EMAIL_PASSWORD=app-specific-secret
