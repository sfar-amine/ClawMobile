{
  "name": "openclaw-plugin-mobile-ui",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/prepare-lite.mjs",
    "dev": "node ./node_modules/typescript/bin/tsc -p tsconfig.json -w",
    "companion:server": "node dist/companion/server.js",
    "test:companion-runs": "node scripts/test-companion-runs.cjs",
    "test:companion-sharing": "node scripts/test-companion-sharing.cjs",
    "test:payment-core": "node scripts/test-payment-core.cjs",
    "test:topnet-live-payment": "node scripts/test-topnet-live-payment-adapter.cjs",
    "test:remote-bridge-core": "node scripts/test-remote-bridge-core.cjs",
    "test:mcp-bridge": "node scripts/test-mcp-bridge.cjs",
    "test:remote-bridge-slack": "node scripts/test-remote-bridge-slack.cjs",
    "test:remote-bridge-slack-resilience": "node scripts/test-remote-bridge-slack-resilience.cjs",
    "accept:remote-bridge-runtime": "python3 scripts/accept-remote-bridge-runtime.py",
    "test:trace-induction": "node scripts/test-trace-induction.cjs",
    "test:provider-fallback": "node scripts/test-provider-fallback.cjs",
    "test:claw-live-warm": "node scripts/test-claw-live-warm.cjs",
    "test:clictopay-provider-adapter": "node scripts/test-clictopay-provider-adapter.cjs",
    "test:payment-handoff": "node scripts/test-payment-handoff.cjs",
    "test:samantha-provider-fallback": "node scripts/test-samantha-provider-fallback.cjs",
    "test:claw-live-warm-cancellation": "node scripts/test-claw-live-warm-cancellation.cjs",
    "test:companion-history-cache": "node scripts/test-companion-history-cache.cjs",
    "test:voice-barge-in": "node scripts/test-voice-turn-protocol.cjs && node scripts/test-warm-v2-ownership.cjs"
  },
  "dependencies": {
    "nostr-tools": "^2.23.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
