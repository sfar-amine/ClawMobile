  "canonicalInboundTimestamp": {
    "answer": "transcript_events.event_json -> $.message.timestamp (epoch ms, WhatsApp provider timestamp, second precision) for rows where $.type='message' AND $.message.role='user' AND $.message.__openclaw.transport.channel='whatsapp'",
    "receivedByGatewayAt": "transcript_events.created_at (epoch ms; == ISO $.timestamp of the event) = time the Gateway persisted the inbound message",
    "dedupeKey": "$.message.__openclaw.transport.messageId (WhatsApp message id); also transcript_event_identities.message_idempotency_key",
    "joinToChannel": "transcript_events.session_id -> session_windows.session_id (channel='whatsapp', chat_type, primary_conversation_id -> conversations.conversation_id)",
    "notCanonical": "conversations.created_at/updated_at are per-conversation, not per-message; conversation_deliveries holds OUTBOUND sends only (operation_kind='send'); no dedicated inbound-message table exists",
    "exampleSql": "SELECT te.session_id, te.seq, json_extract(te.event_json,'$.message.timestamp') AS wa_ts_ms, te.created_at AS persisted_ms FROM transcript_events te JOIN session_windows sw ON sw.session_id=te.session_id WHERE sw.channel='whatsapp' AND json_extract(te.event_json,'$.type')='message' AND json_extract(te.event_json,'$.message.role')='user' AND json_extract(te.event_json,'$.message.__openclaw.transport.channel')='whatsapp' ORDER BY wa_ts_ms",
    "inboundWhatsAppUserMessagesInStore": 91,
    "caveats": [
      "event_json may be NULL when the event is stored compressed in event_zstd (BLOB); decode before json_extract",
      "user-role rows in WhatsApp sessions without __openclaw.transport (heartbeat/system injections) have ms-precision timestamps and must be excluded",
      "transcripts can be compacted/archived (session_transcript_archives) so old inbound rows may move out of transcript_events"
    ]
  },
