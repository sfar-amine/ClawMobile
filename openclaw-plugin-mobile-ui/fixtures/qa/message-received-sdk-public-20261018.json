    {
      "name": "PluginHookMessageContext",
      "start": 455,
      "end": 508,
      "truncated": false,
      "source": [
        {
          "line": 455,
          "text": "type PluginHookMessageContext = {"
        },
        {
          "line": 456,
          "text": "  channelId: string;"
        },
        {
          "line": 457,
          "text": "  accountId?: string;"
        },
        {
          "line": 458,
          "text": "  conversationId?: string;"
        },
        {
          "line": 459,
          "text": "  /**"
        },
        {
          "line": 460,
          "text": "   * Canonical session key for this conversation — the same value the agent"
        },
        {
          "line": 461,
          "text": "   * runtime sees as `params.sessionKey` for the run that produced the"
        },
        {
          "line": 462,
          "text": "   * outbound payload, and the same value `agent_end`/`llm_input`/`llm_output`"
        },
        {
          "line": 463,
          "text": "   * fire with. Plugins correlating per-turn state across `agent_end` and"
        },
        {
          "line": 464,
          "text": "   * `message_sending` rely on this equality."
        },
        {
          "line": 465,
          "text": "   *"
        },
        {
          "line": 466,
          "text": "   * For inbound message hooks (`inbound_claim` etc.), this is the canonical"
        },
        {
          "line": 467,
          "text": "   * session for the inbound conversation as resolved by `resolveSessionKey`"
        },
        {
          "line": 468,
          "text": "   * / `deriveInboundMessageHookContext`."
        },
        {
          "line": 469,
          "text": "   *"
        },
        {
          "line": 470,
          "text": "   * For outbound delivery hooks (`message_sending` and `message_sent`),"
        },
        {
          "line": 471,
          "text": "   * this mirrors `OutboundSessionContext.key` from the dispatch path when"
        },
        {
          "line": 472,
          "text": "   * delivery has a session attached. When the outbound path has no"
        },
        {
          "line": 473,
          "text": "   * resolvable session (e.g. internal smoke runs without"
        },
        {
          "line": 474,
          "text": "   * `OutboundSessionContext`), this field is omitted; plugins must treat"
        },
        {
          "line": 475,
          "text": "   * it as optional."
        },
        {
          "line": 476,
          "text": "   */"
        },
        {
          "line": 477,
          "text": "  sessionKey?: string;"
        },
        {
          "line": 478,
          "text": "  /**"
        },
        {
          "line": 479,
          "text": "   * Per-turn run identifier (UUID), unique to one end-to-end agent turn:"
        },
        {
          "line": 480,
          "text": "   * stable across all LLM-call iterations, retry attempts (compaction,"
        },
        {
          "line": 481,
          "text": "   * empty-response, planning-only, etc.), and multi-payload reply chunks"
        },
        {
          "line": 482,
          "text": "   * within that turn; distinct for each new inbound user message and for"
        },
        {
          "line": 483,
          "text": "   * each cron/heartbeat/followup-triggered run."
        },
        {
          "line": 484,
          "text": "   *"
        },
        {
          "line": 485,
          "text": "   * Generated once in `agent-runner-execution.ts`/`followup-runner.ts` via"
        },
        {
          "line": 486,
          "text": "   * `crypto.randomUUID()`. Currently populated for inbound message hooks"
        },
        {
          "line": 487,
          "text": "   * (`inbound_claim`, `message_received`) and for agent-runtime hooks that"
        },
        {
          "line": 488,
          "text": "   * already receive the run id (e.g. `agent_end`, `llm_input`, `llm_output`)."
        },
        {
          "line": 489,
          "text": "   * It is **not yet** plumbed through the outbound delivery path, so"
        },
        {
          "line": 490,
          "text": "   * plugins observing `message_sending` / `message_sent` should not rely"
        },
        {
          "line": 491,
          "text": "   * on `runId` to correlate against `agent_end`; use `sessionKey` for"
        },
        {
          "line": 492,
          "text": "   * outbound→inbound correlation today (with the caveat that it cannot"
        },
        {
          "line": 493,
          "text": "   * disambiguate concurrent turns in the same session)."
        },
        {
          "line": 494,
          "text": "   */"
        },
        {
          "line": 495,
          "text": "  runId?: string;"
        },
        {
          "line": 496,
          "text": "  messageId?: string;"
        },
        {
          "line": 497,
          "text": "  senderId?: string;"
        },
        {
          "line": 498,
          "text": "  replyToId?: string;"
        },
        {
          "line": 499,
          "text": "  replyToIdFull?: string;"
        },
        {
          "line": 500,
          "text": "  replyToBody?: string;"
        },
        {
          "line": 501,
          "text": "  replyToSender?: string;"
        },
        {
          "line": 502,
          "text": "  replyToIsQuote?: boolean;"
        },
        {
          "line": 503,
          "text": "  trace?: DiagnosticTraceContext;"
        },
        {
          "line": 504,
          "text": "  traceId?: string;"
        },
        {
          "line": 505,
          "text": "  spanId?: string;"
        },
        {
          "line": 506,
          "text": "  parentSpanId?: string;"
        },
        {
          "line": 507,
          "text": "  callDepth?: number;"
        },
        {
          "line": 508,
          "text": "};"
        }
      ]
