{
  "id": "openclaw-plugin-mobile-ui",
  "name": "Mobile UI",
  "description": "Android mobile runtime tools for OpenClaw's capability-aware Termux/ADB runtime.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "clawmobile_capability",
      "transmettre_a_amine",
      "noter_contact",
      "android_health",
      "android_screenshot",
      "android_tap",
      "android_type",
      "android_swipe",
      "android_ui_dump",
      "android_ui_query",
      "android_match_text_queries",
      "android_resolve_text_queries",
      "android_ocr_dump",
      "clawmobile_record_start",
      "clawmobile_record_stop",
      "clawmobile_record_parse",
      "clawmobile_record_status",
      "clawmobile_trace_prepare_summary",
      "clawmobile_trace_save_skill_candidate",
      "clawmobile_skill_candidate_promote",
      "clawmobile_skill_generalize",
      "clawmobile_skill_update_from_trace",
      "clawmobile_skill_record_feedback",
      "clawmobile_skill_status",
      "clawmobile_skill_run_fast_path",
      "clawmobile_skill_reflect_fast_path_failure",
      "clawmobile_batch_execute",
      "android_signal_complete",
      "adb_devices",
      "adb_keyevent",
      "adb_ui_dump_xml",
      "adb_screenshot",
      "adb_tap",
      "adb_type",
      "adb_swipe",
      "tx_notify",
      "tx_tts",
      "tx_toast",
      "tx_clipboard_get",
      "tx_clipboard_set",
      "tx_battery_status",
      "android_shell",
      "samantha_agenda",
      "samantha_laptop_s24_termux",
      "samantha_maxit_tunisie",
      "samantha_pulse",
      "samantha_sonede",
      "samantha_steg",
      "samantha_topnet",
      "samantha_tunisie_telecom",
      "samantha_utility_billing",
      "samantha_whatsapp",
      "samantha_zain_bahrain",
      "samantha_app",
      "samantha_catalogue"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "voiceBargeIn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "qualifiedRoutes": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          "protocolModel": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "whatsappModelFlow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "model",
          "thinkingDefault",
          "fastModeDefault"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primary",
              "fallbacks"
            ],
            "properties": {
              "primary": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._:/+@-]{1,200}$"
              },
              "fallbacks": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9._:/+@-]{1,200}$"
                }
              }
            }
          },
          "thinkingDefault": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "adaptive",
              "max",
              "ultra"
            ]
          },
          "fastModeDefault": {
            "type": "boolean"
          }
        }
      },
      "modelFlowSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "flows"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "flows": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "brain": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "fieldsHash"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "const": 1
                  },
                  "fieldsHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "conversation_summary": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "fieldsHash"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "const": 1
                  },
                  "fieldsHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "whatsapp": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "fieldsHash"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "const": 1
                  },
                  "fieldsHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
